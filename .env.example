# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (RAG chat assistant)
GROQ_API_KEY=
# (선택) 사용할 Groq 모델. 비우면 llama-3.3-70b-versatile
GROQ_MODEL=

# Admin dashboard password (src/app/[locale]/admin)
PAGE_ACCESS_PASSWORD=

# Resend (contact form / newsletter emails)
RESEND_API_KEY=

# /api/cron/keepalive, /api/health 호출 인증용 비밀 값.
# Vercel 프로젝트 환경변수에 설정하면 Vercel Cron이 Bearer 헤더로 자동 전달합니다.
# GitHub Actions의 HEALTH_KEY 시크릿에도 같은 값을 넣습니다.
CRON_SECRET=
