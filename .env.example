# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (RAG chat assistant)
GROQ_API_KEY=

# Admin dashboard password (src/app/[locale]/admin)
PAGE_ACCESS_PASSWORD=

# Resend (contact form / newsletter emails)
RESEND_API_KEY=

# Vercel Cron auth — Vercel auto-provisions this once you enable a cron job.
# Set it manually only if you want to test the route locally / outside Vercel.
CRON_SECRET=
